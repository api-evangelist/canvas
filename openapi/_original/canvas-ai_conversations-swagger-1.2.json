    {
      "path": "/v1/courses/{course_id}/ai_experiences/{ai_experience_id}/conversations/{id}/evaluation",
      "description": "Fetch the latest stored evaluation for a conversation from the\nllm-conversation service. Reads only — does not run the LLM and is not\nrate-limited. `evaluation` is null when none has been generated yet (llma\nreturns 200 + null, never 404, so this is distinguishable from an outage).\n`stale` is true when the AI experience was edited after the stored\nevaluation was generated.",
      "operations": [
        {
          "method": "GET",
          "summary": "Get conversation evaluation",
          "notes": "Fetch the latest stored evaluation for a conversation from the\nllm-conversation service. Reads only — does not run the LLM and is not\nrate-limited. `evaluation` is null when none has been generated yet (llma\nreturns 200 + null, never 404, so this is distinguishable from an outage).\n`stale` is true when the AI experience was edited after the stored\nevaluation was generated.",
          "nickname": "get_conversation_evaluation",
          "parameters": [
            {
              "paramType": "path",
              "name": "course_id",
              "description": "ID",
              "type": "string",
              "format": null,
              "required": true,
              "deprecated": false
            },
